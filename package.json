{
  "name": "shiye-clipper",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Local-first batch full-page web capture for humans and AI agents.",
  "author": "Xu Ziqiu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuziqiu/shiye-clipper.git"
  },
  "homepage": "https://github.com/xuziqiu/shiye-clipper#readme",
  "bugs": {
    "url": "https://github.com/xuziqiu/shiye-clipper/issues"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "keywords": [
    "full-page-screenshot",
    "web-clipper",
    "playwright",
    "microsoft-edge",
    "google-chrome",
    "batch-capture"
  ],
  "bin": {
    "shiye": "dist/src/cli.js",
    "clipper": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "shiye": "tsx src/cli.ts",
    "clipper": "tsx src/cli.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "node --import tsx --test tests/e2e/*.test.ts",
    "verify": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "express": "^5.1.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
